{
   "action": {
      "default_title": "FriendFilter"
   },
   "author": "Kenny Crotty \u003Ckennyg1700@gmail.com>",
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "all_frames": false,
      "js": [ "content.js" ],
      "matches": [ "https://*.facebook.com/*" ],
      "run_at": "document_start"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"
   },
   "description": "Remove inactive Facebook friends and track engagement. See who actually interacts and clean up your friend list with confidence.",
   "externally_connectable": {
      "matches": [ "https://app.friendfilter.io/*", "https://*.facebook.com/*" ]
   },
   "host_permissions": [ "https://app.friendfilter.io/*", "https://api.friendfilter.io/*", "https://*.facebook.com/*" ],
   "icons": {
      "128": "icons/128.png",
      "16": "icons/16.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "FriendFilter - Friend List Manager & Engagement Tracker",
   "permissions": [ "scripting", "storage", "alarms" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "7.4.4",
   "web_accessible_resources": [ {
      "matches": [ "https://app.friendfilter.io/*", "https://*.facebook.com/*" ],
      "resources": [ "app.js", "robot-background.js", "robot-content.js", "styles.scss", "script.js" ]
   } ]
}
