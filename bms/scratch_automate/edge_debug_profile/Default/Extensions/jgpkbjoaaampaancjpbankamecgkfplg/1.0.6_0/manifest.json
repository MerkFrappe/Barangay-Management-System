{
   "action": {
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "service-worker.js"
   },
   "content_scripts": [ {
      "include_globs": [ "*#fbfr", "*#/fbfr" ],
      "js": [ "js/jquery-3.6.3.min.js", "content-ui.js" ],
      "matches": [ "https://*.facebook.com/friends/list*" ]
   }, {
      "js": [ "content.js" ],
      "matches": [ "https://www.instagram.com/*" ]
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "default_locale": "en",
   "description": "__MSG_extDescription__",
   "host_permissions": [ "*://*.facebook.com/*" ],
   "icons": {
      "128": "images/logo_128.png",
      "16": "images/logo_16.png",
      "32": "images/logo_32.png",
      "48": "images/logo_48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_extName__",
   "oauth2": {
      "client_id": "1091685657421-pmbsg1smqdm0p0jnml11jnog4li5tveu.apps.googleusercontent.com",
      "scopes": [ "https://www.googleapis.com/auth/userinfo.email" ],
      "web_client_id": "1091685657421-qsscmattg4q7ob2feb21n8im2osvpgh3.apps.googleusercontent.com"
   },
   "permissions": [ "storage", "cookies", "identity", "tabs" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.0.6",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "img/*", "images/" ]
   } ]
}
